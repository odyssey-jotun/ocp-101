---
import Base from '../layouts/Base.astro';
import RubricTabs from './RubricTabs';
import { HoverLink } from './ui/hover-link';
import CleanCTA from './CleanCTA.astro';
import { outcomes, assignments, rubrics, materials, ways, waysInOrder, emailGuide, LINKEDIN_TAB } from '../data/course';

interface Props { i: number }
const { i } = Astro.props;
const base = import.meta.env.BASE_URL;
const way = ways[i];
const outcome = outcomes[i];
const rubric = rubrics.filter((r) => r.key === way.rubric);
const work = assignments.filter((a) => a.way === i);
const kit = materials.filter((m) => m.way === i);
const others = waysInOrder.filter((w) => w.k !== i);
// Jump links to each section; every section below carries the matching id.
const toc: [string, string][] = [
  ['skills', 'What you will be able to do'],
  ['steps', way.slug === 'audience' ? 'The macro structure' : 'The steps'],
  ['assignments', 'Assignments'],
  rubric.length > 0 ? ['scoring', 'How it is scored'] : ['emails', 'How to write your emails'],
  ...(kit.length > 0 ? [['materials', 'What you need'] as [string, string]] : []),
];
---
<Base title={`${way.title} | OCP 101`} description={outcome.title} current={way.slug}>
  <div class="relative isolate overflow-hidden">
  <section class="wrap relative pt-10 sm:pt-16">
    <h1 class="font-serif text-5xl leading-[1.02] tracking-tight sm:text-7xl">
      <span class="text-primary">0{way.n}</span> {way.title}
    </h1>
    <p class="lede mt-4">{outcome.title}</p>
    <nav aria-label="On this page" class="mt-6">
      <p class="text-sm font-semibold">On this page</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {toc.map(([id, label]) => (
          <li><a href={`#${id}`} class="inline-flex rounded-full border bg-card px-4 py-2 text-sm transition-colors hover:border-primary/40 hover:text-primary">{label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="mt-10 grid items-stretch gap-4 lg:grid-cols-[0.85fr_1.15fr]">
      <img src={`${base}img/way-${way.slug}-1200.webp`} srcset={`${base}img/way-${way.slug}-720.webp 720w, ${base}img/way-${way.slug}-1200.webp 1200w`} sizes="(min-width: 1024px) 40vw, 100vw" width="1200" height="900" fetchpriority="high" decoding="async" alt={way.alt} class="aspect-[4/3] h-full w-full rounded-[28px] object-cover lg:aspect-auto" />
      <slot name="about" />
    </div>
  </section>
  </div>


  <section class="section !pt-12">
    <div class="wrap">
      <h2 id="skills" data-reveal class="h-section">What you will be able to do</h2>
      <div data-reveal class="mt-8 grid items-start gap-4 md:grid-cols-2">
        {outcome.tiers.map((t) => (
          <div class="rounded-[18px] border bg-card p-6">
            <h3 class="font-serif text-3xl leading-none">{t.label}</h3>
            <ul data-reveal class="mt-3 grid gap-2.5">
              {t.items.map((pt) => <li class="flex gap-2.5 leading-relaxed text-muted-foreground"><span aria-hidden="true" class="mt-2.5 size-1.5 shrink-0 rounded-full bg-primary/60"></span><span>{pt}</span></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <slot name="steps" />

  <section class="section">
    <div class="wrap">
      <h2 id="assignments" data-reveal class="h-section">Assignments</h2>
      <p class="lede">Due before the session on the date listed. Numbers match the full course list, which runs in due-date order.</p>
      <ol class="mt-8 border-t border-foreground/10">
        {work.map((a) => (
          <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 gap-y-1 border-b border-foreground/10 py-4 sm:grid-cols-[3rem_1fr_9rem_7rem] sm:items-baseline">
            <span class="font-serif text-2xl leading-none text-muted-foreground">{String(a.n).padStart(2, '0')}</span>
            <span class="leading-snug">{a.title}</span>
            <span class="col-start-2 text-sm text-muted-foreground sm:col-start-auto">{a.length}</span>
            <span class="col-start-2 text-sm font-medium sm:col-start-auto sm:text-right">{a.due}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

{rubric.length > 0 ? (
  <section class="section">
    <div class="wrap">
      <h2 id="scoring" data-reveal class="h-section">How it is scored</h2>
      <p class="lede">From 4 to 0, explained on the <a class="inline" href={`${base}#scoring`}>home page</a>. A shaded cell means that score is not used for that part.</p>
      <div class="mt-8">
        <RubricTabs client:visible rubrics={rubric} />
      </div>
    </div>
  </section>
) : (
  <section class="section">
    <div class="wrap">
      <h2 id="emails" data-reveal class="h-section">How to write your emails</h2>
      <p class="lede">Every session email, and every email to a professor or club contact, has these five parts, in this order.</p>
      <div data-reveal class="mt-8 grid gap-8 lg:grid-cols-[1.3fr_1fr]">
        <ol class="grid gap-3">
          {emailGuide.map((e, k) => (
            <li class="grid gap-1 rounded-[18px] border bg-card p-5 sm:grid-cols-[2rem_1fr]">
              <span class="font-serif text-2xl leading-none text-primary">{k + 1}</span>
              <div>
                <p class="font-semibold">{e.part}</p>
                <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{e.how}</p>
                <p class="mt-2 border-l-2 border-primary/40 pl-3 text-sm italic">“{e.example}”</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="self-start rounded-[18px] border bg-card p-6 lg:sticky lg:top-24">
          <p class="font-serif text-2xl leading-none">Put together</p>
          <div class="mt-4 rounded-xl bg-secondary/60 p-5 text-sm leading-relaxed">
            <p class="text-muted-foreground">Subject: Benchmark video for Wednesday</p>
            <p class="mt-4">Hello, Marc,</p>
            <p class="mt-3">Thanks for the tip on transitions Monday. I’m sending my benchmark video for Wednesday’s session. It’s uploaded to my Drive folder for the course.</p>
            <p class="mt-3">See you Wednesday,<br />[Your full name]</p>
          </div>
        </div>
      </div>
    </div>
  </section>
)}

  {kit.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2 id="materials" data-reveal class="h-section">What you need</h2>
        <div data-reveal class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {kit.map((m) => (
            <div class="rounded-[18px] border bg-card p-6">
              <h3 class="h-item">{m.href ? <a class="hover:text-primary" href={m.href} target="_blank" rel="noreferrer">{m.title} <span aria-hidden="true">↗</span></a> : m.title}</h3>
              <p class="text-sm leading-relaxed text-muted-foreground">{m.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {way.slug === 'online' && (
    <div class="wrap">
      <CleanCTA title="Start with the LinkedIn worksheet" description="Fill it out before we touch your profile, due Monday, October 12. We will go from there." href={LINKEDIN_TAB} action="Open the worksheet" />
    </div>
  )}

  <section class="section">
    <div class="wrap">
      <h2 class="h-sub">The other two ways</h2>
      <div data-reveal class="mt-4 grid gap-3 sm:grid-cols-2">
        {others.map((w) => (
          <a href={`${base}${w.slug}/`} class="flex flex-col rounded-[18px] border bg-card p-5 transition-colors hover:border-primary/40">
            <span class="font-serif text-3xl leading-none text-primary">0{w.n}</span>
            <span class="mt-3 font-semibold">{w.title}</span>
            <span class="mt-1 text-sm leading-relaxed text-muted-foreground">{w.short}</span>
          </a>
        ))}
      </div>
      <div class="mt-8"><HoverLink text="Back to the course" href={base} /></div>
    </div>
  </section>
</Base>
