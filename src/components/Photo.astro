---
// A rounded, graded photo from public/img, served at two widths.
interface Props { name: string; alt: string; ratio?: string; class?: string; eager?: boolean; sizes?: string }
const { name, alt, ratio = 'aspect-[4/3]', class: cls = '', eager = false, sizes = '(min-width: 1024px) 45vw, 100vw' } = Astro.props;
const base = import.meta.env.BASE_URL;
const src = (w: number) => `${base}img/${name}-${w}.webp`;
---
<img src={src(1200)} srcset={`${src(720)} 720w, ${src(1200)} 1200w`} sizes={sizes} width="1200" height="900"
  loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" alt={alt}
  class:list={[ratio, 'w-full rounded-[28px] object-cover', cls]} />
