---
// One page per session: deliverables first, then the big ideas, then each topic
// and the professionalism score folded into a dropdown, then the locked speech archive.
// Content lives in `sessions` in src/data/course.ts, newest first.
import Base from '../../layouts/Base.astro';
import { HoverLink } from '../../components/ui/hover-link';
import SpeechArchive from '../../components/SpeechArchive.astro';
import { sessions, WORKSPACE } from '../../data/course';

export function getStaticPaths() {
  return sessions.map((s) => ({ params: { n: String(s.n) }, props: { s } }));
}

const { s } = Astro.props;
const base = import.meta.env.BASE_URL;
const bullet = 'mt-2.5 size-1.5 shrink-0 rounded-full bg-primary/60';
// Neighbours by position, so a session missing from the site doesn't break the links.
const i = sessions.indexOf(s);
const newer = sessions[i - 1];
const older = sessions[i + 1];
// Number deliverables within their group, and mark where each group starts.
const items = s.deliverables.map((d, k) => {
  const first = k === 0 || d.group !== s.deliverables[k - 1].group;
  const num = s.deliverables.slice(0, k + 1).filter((x) => x.group === d.group).length;
  return { ...d, first: first && !!d.group, num };
});
const fold = 'group min-w-0 rounded-[18px] border bg-card';
const head = 'flex cursor-pointer list-none items-center justify-between gap-4 p-6 [&::-webkit-details-marker]:hidden';
const chevron = 'size-5 shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180';
---
<Base title={`Session ${s.n} | OCP 101`} description={`${s.title}: what we covered on ${s.date}, and what is due next.`} current="sessions">
  <section class="wrap pt-10 sm:pt-16">
    <a href={`${base}sessions/`} class="text-sm font-medium text-primary underline-offset-4 hover:underline">All sessions</a>
    <p class="mt-6 text-sm font-medium text-primary">Session {s.n} · {s.date}</p>
    <h1 class="mt-2 font-serif text-5xl leading-[1.02] tracking-tight sm:text-6xl">{s.title}</h1>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="rounded-[18px] bg-foreground p-6 text-background sm:p-8">
        <h2 class="font-serif text-3xl leading-none">Your deliverables</h2>
        <ol class="mt-5 grid gap-3">
          {items.map((d) => (<>
            {d.first && <li class="pt-4 font-serif text-xl leading-none text-background first:pt-0">{d.group}</li>}
            <li class="grid grid-cols-[2rem_1fr] gap-x-3 gap-y-1 border-t border-background/15 pt-3 sm:grid-cols-[2rem_1fr_11rem]">
              <span class="font-serif text-2xl leading-none text-background/60">{d.num}</span>
              <span class="leading-relaxed">{d.text}{d.href && (d.href.startsWith('#')
                ? <> <a href={d.href} class="whitespace-nowrap font-medium underline underline-offset-4">{d.link} ↓</a></>
                : <> <a href={d.href} target="_blank" rel="noreferrer" class="whitespace-nowrap font-medium underline underline-offset-4">{d.link} ↗</a></>)}</span>
              <span class="col-start-2 text-sm font-medium text-background/70 sm:col-start-auto sm:text-right">{d.due}</span>
            </li>
          </>))}
        </ol>
      </div>

      {s.drafts?.map((e) => (
        <div id={e.id} class="mt-12 scroll-mt-24">
          <h2 class="font-serif text-3xl leading-none">{e.title}</h2>
          <p class="mt-3 text-muted-foreground">{e.note}</p>
          <div class="mt-5 min-w-0 rounded-[18px] border bg-card p-6">
            <p class="text-sm text-muted-foreground"><span class="font-medium text-foreground/70">Subject: </span>{e.subject}</p>
            <div class="mt-4 grid gap-3 border-t pt-4 leading-relaxed">
              {e.lines.map((l) => <p class="whitespace-pre-line">{l}</p>)}
            </div>
          </div>
        </div>
      ))}

      {s.fixes && (
        <div id="fixes" class="mt-12 scroll-mt-24">
          <h2 class="font-serif text-3xl leading-none">Outline fixes, line by line</h2>
          <p class="mt-3 text-muted-foreground">{s.fixes.reduce((n, g) => n + g.items.length, 0)} fixes, in the order they appear in your outline. “Now” is what your outline says today. “Say” is a model line: use it or put it in your own words.</p>
          <div class="mt-5 grid gap-4">
            {s.fixes.map((g, gi) => {
              const start = s.fixes!.slice(0, gi).reduce((n, x) => n + x.items.length, 0);
              return (
                <div class="min-w-0 rounded-[18px] border bg-card p-6">
                  <h3 class="font-serif text-2xl leading-tight">{g.section}</h3>
                  <ol class="mt-4 grid gap-4">
                    {g.items.map((f, k) => (
                      <li class="grid grid-cols-[2rem_1fr] gap-x-2 border-t pt-4">
                        <span class="font-serif text-xl leading-snug text-primary">{start + k + 1}</span>
                        <div class="min-w-0">
                          <p class="font-semibold leading-snug">{f.line}</p>
                          {f.now && <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground"><span class="font-medium text-foreground/70">Now: </span>{f.now}</p>}
                          <p class="mt-1.5 leading-relaxed">{f.fix}</p>
                          {f.say && <p class="mt-2 rounded-xl bg-primary/[0.06] px-4 py-3 text-sm leading-relaxed"><span class="font-medium text-primary">Say: </span>{f.say}</p>}
                        </div>
                      </li>
                    ))}
                  </ol>
                </div>
              );
            })}
          </div>
        </div>
      )}

      {s.research && (
        <div class="mt-12">
          <h2 class="font-serif text-3xl leading-none">Research for your sub-points</h2>
          <p class="mt-3 text-muted-foreground">Open each source yourself, then write the citation sentence in your own words: who, when, what.</p>
          <div class="mt-5 grid gap-4">
            {s.research.map((g) => (
              <div class="rounded-[18px] border bg-card p-6">
                <h3 class="font-serif text-2xl leading-tight">{g.title}</h3>
                <ul class="mt-4 grid gap-4">
                  {g.items.map((r) => (
                    <li class="border-t pt-4">
                      <p class="font-semibold leading-snug">{r.sub}</p>
                      <p class="mt-1 leading-relaxed text-muted-foreground">{r.finding}</p>
                      <a href={r.href} target="_blank" rel="noreferrer" class="mt-1 inline-block text-sm font-medium text-primary underline underline-offset-4">{r.source} ↗</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      )}

      <div class="mt-12 rounded-[18px] bg-primary/[0.06] p-6 sm:p-8">
        <h2 class="font-serif text-3xl leading-none">The big ideas</h2>
        <ol class="mt-5 grid gap-x-10 gap-y-5 md:grid-cols-2">
          {s.takeaways.map((t, k) => (
            <li class="grid grid-cols-[2rem_1fr] gap-x-2">
              <span class="font-serif text-2xl leading-none text-primary">{k + 1}</span>
              <div>
                <p class="font-semibold leading-snug">{t.idea}</p>
                <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{t.why}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <h2 class="mt-12 font-serif text-3xl leading-none">What we covered</h2>
      <p class="mt-2 text-sm text-muted-foreground">Tap a topic to open it.</p>
      <div class="mt-4 grid gap-3">
        {s.topics.map((t) => (
          <details class={fold}>
            <summary class={head}>
              <span class="font-serif text-2xl leading-tight">{t.title}</span>
              <svg aria-hidden="true" class={chevron} viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 8 5 5 5-5" /></svg>
            </summary>
            <ul class="grid gap-3 px-6 pb-6">
              {t.points.map((p) => typeof p === 'string' ? (
                <li class="flex gap-2.5 leading-relaxed text-muted-foreground"><span aria-hidden="true" class={bullet}></span><span>{p}</span></li>
              ) : (
                <li class="leading-relaxed">
                  <div class="flex gap-2.5"><span aria-hidden="true" class={bullet}></span><span class="font-semibold">{p.text}</span></div>
                  {p.sub.length > 0 && (
                    <ul class="mt-2 grid gap-2 border-l-2 border-primary/25 pl-4 ml-[3px]">
                      {p.sub.map((q) => <li class="text-sm leading-relaxed text-muted-foreground">{q}</li>)}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </details>
        ))}

        {s.professionalism && (
          <details class={fold}>
            <summary class={head}>
              <span class="font-serif text-2xl leading-tight">Professionalism <span class="text-primary">{s.professionalism.score}</span><span class="text-lg text-muted-foreground"> / 5</span></span>
              <svg aria-hidden="true" class={chevron} viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 8 5 5 5-5" /></svg>
            </summary>
            <ul class="grid gap-2 px-6 pb-6">
              {s.professionalism.items.map(([item, pt, note]) => (
                <li class="rounded-xl bg-secondary/50 px-4 py-3">
                  <div class="flex items-center justify-between gap-4"><span>{item}</span><span class:list={['shrink-0 text-sm font-semibold', pt ? 'text-primary' : 'text-muted-foreground']}>{pt} pt</span></div>
                  {note && <p class="mt-1 text-sm text-muted-foreground">{note}</p>}
                </li>
              ))}
            </ul>
          </details>
        )}

        <SpeechArchive />
      </div>

      <nav aria-label="Other sessions" class="mt-8 flex flex-wrap justify-between gap-4 text-sm">
        {older ? <a href={`${base}sessions/${older.n}/`} class="rounded-full border bg-card px-4 py-2 transition-colors hover:border-primary/40">← Session {older.n}: {older.title}</a> : <span></span>}
        {newer && <a href={`${base}sessions/${newer.n}/`} class="rounded-full border bg-card px-4 py-2 transition-colors hover:border-primary/40">Session {newer.n}: {newer.title} →</a>}
      </nav>
    </div>
  </section>

  <div class="wrap pb-16 flex flex-wrap gap-6">
    <HoverLink text="All sessions" href={`${base}sessions/`} />
    <HoverLink text="Open your workspace" href={WORKSPACE} target="_blank" rel="noreferrer" />
  </div>
</Base>
