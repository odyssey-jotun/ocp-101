---
// Session index: one card per session, newest first, each linking to its own page.
// Old emailed links point at /sessions/#session-N; the script sends those to /sessions/N/.
import Base from '../../layouts/Base.astro';
import { HoverLink } from '../../components/ui/hover-link';
import { sessions, WORKSPACE } from '../../data/course';
const base = import.meta.env.BASE_URL;
---
<Base title="Sessions | OCP 101" description="What we covered in each session, and what is due next." current="sessions">
  <script is:inline define:vars={{ base }}>
    const m = location.hash.match(/^#session-(\d+)$/);
    if (m) location.replace(`${base}sessions/${m[1]}/`);
  </script>
  <section class="wrap pt-10 sm:pt-16">
    <h1 class="font-serif text-5xl leading-[1.02] tracking-tight sm:text-7xl">Sessions</h1>
    <p class="lede mt-4">One page per session, newest first. Each one has the big ideas, what we covered, and what you owe before the next.</p>
  </section>

  <section class="section">
    <div class="wrap grid gap-4">
      {sessions.map((s, i) => (
        <a id={`session-${s.n}`} href={`${base}sessions/${s.n}/`} class:list={['group block rounded-[18px] border p-6 transition-colors hover:border-primary/40 sm:p-8', i === 0 ? 'bg-primary/[0.06]' : 'bg-card']}>
          <p class="text-sm font-medium text-primary">Session {s.n} · {s.date}{i === 0 && ' · Latest'}</p>
          <h2 class="mt-2 font-serif text-3xl leading-tight sm:text-4xl">{s.title}</h2>
          <ul class="mt-4 grid gap-1.5 text-sm text-muted-foreground">
            {s.takeaways.slice(0, 3).map((t) => <li class="flex gap-2.5"><span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-primary/60"></span>{t.idea}</li>)}
          </ul>
          <p class="mt-5 text-sm font-medium">{s.deliverables.length} deliverables · <span class="text-primary underline-offset-4 group-hover:underline">Open session {s.n} →</span></p>
        </a>
      ))}
    </div>
  </section>

  <div class="wrap pb-16 flex flex-wrap gap-6">
    <HoverLink text="Back to the course" href={base} />
    <HoverLink text="Open your workspace" href={WORKSPACE} target="_blank" rel="noreferrer" />
  </div>
</Base>
